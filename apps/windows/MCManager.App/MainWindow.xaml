<Window
    x:Class="MCManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MCManager.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="ErrorBar"
            x:Uid="ErrorBar"
            Grid.Row="0"
            Severity="Error"
            IsClosable="True"
            IsOpen="False"
            Closed="OnErrorClosed" />
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ServersItem" x:Uid="NavServers" Tag="servers">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConnectionItem" x:Uid="NavConnection" Tag="connection">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <views:ServersView x:Name="ServersPage" />
                <views:ServerDetailView x:Name="DetailPage" Visibility="Collapsed" />
                <views:CreateServerView x:Name="CreatePage" Visibility="Collapsed" />
                <views:ConnectionView x:Name="ConnectionPage" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
