<UserControl
    x:Class="MCManager.App.Views.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock x:Uid="ConnectionTitle" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Uid="ConnectionHint" TextWrapping="Wrap" />
        <ListView x:Name="TargetList" DisplayMemberPath="Name" SelectionMode="Single" SelectionChanged="OnSelectionChanged" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ConnectButton" x:Uid="ConnectButton" Click="OnConnect" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="AddButton" x:Uid="AddRemoteButton" Click="OnAdd" />
            <Button x:Name="RemoveButton" x:Uid="RemoveRemoteButton" Click="OnRemove" />
        </StackPanel>
    </StackPanel>
</UserControl>
