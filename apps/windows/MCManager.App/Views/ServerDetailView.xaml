<UserControl
    x:Class="MCManager.App.Views.ServerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cl="using:MCManager.Client"
    xmlns:vm="using:MCManager.ViewModels"
    xmlns:app="using:MCManager.App">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" x:Uid="BackButton" Click="OnBackClick">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{x:Bind app:Strings.State(ViewModel.State), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" x:Uid="StartButton" Command="{x:Bind ViewModel.StartCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                <SymbolIcon Symbol="Play" />
            </Button>
            <Button x:Name="StopButton" x:Uid="StopButton" Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                <SymbolIcon Symbol="Stop" />
            </Button>
            <Button x:Name="RestartButton" x:Uid="RestartButton" Command="{x:Bind ViewModel.RestartCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanRestart, Mode=OneWay}">
                <SymbolIcon Symbol="Sync" />
            </Button>
            <Button x:Name="ResumeButton" x:Uid="ResumeButton" Command="{x:Bind ViewModel.ResumeCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}">
                <SymbolIcon Symbol="Forward" />
            </Button>
            <Button x:Name="DetailRefreshButton" x:Uid="DetailRefreshButton" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </StackPanel>
        <Pivot Grid.Row="2">
            <PivotItem x:Uid="ConsoleTab">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView
                        x:Name="ConsoleList"
                        x:Uid="ConsoleList"
                        ItemsSource="{x:Bind ViewModel.Console.Lines, Mode=OneWay}"
                        SelectionMode="None"
                        FontFamily="Consolas">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleInput" x:Uid="ConsoleInput" Text="{x:Bind ViewModel.Console.CommandText, Mode=TwoWay}" KeyDown="OnConsoleKeyDown" />
                        <Button x:Name="SendButton" x:Uid="SendButton" Grid.Column="1" Command="{x:Bind ViewModel.Console.SendCommand, Mode=OneWay}">
                            <SymbolIcon Symbol="Send" />
                        </Button>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem x:Uid="PlayersTab">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="OnlineLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Players.OnlineText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Players.Online, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <TextBlock Text="{x:Bind}" VerticalAlignment="Center" MinWidth="160" />
                                        <Button x:Uid="KickButton" Tag="{x:Bind}" Click="OnKickClick">
                                            <SymbolIcon Symbol="Cancel" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Uid="ListLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="KindBox" x:Uid="KindBox" SelectedItem="{x:Bind ViewModel.Players.SelectedKind, Mode=TwoWay}" MinWidth="160" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="SubjectBox" x:Uid="SubjectBox" Text="{x:Bind ViewModel.Players.NewSubject, Mode=TwoWay}" MinWidth="200" />
                            <TextBox x:Name="ReasonBox" x:Uid="ReasonBox" Text="{x:Bind ViewModel.Players.Reason, Mode=TwoWay}" MinWidth="200" />
                            <Button x:Name="AddButton" x:Uid="AddButton" Command="{x:Bind ViewModel.Players.AddCommand, Mode=OneWay}">
                                <SymbolIcon Symbol="Add" />
                            </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Players.Entries, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="cl:PlayerListEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <TextBlock Text="{x:Bind Subject}" VerticalAlignment="Center" MinWidth="160" />
                                        <TextBlock Text="{x:Bind Reason}" VerticalAlignment="Center" Opacity="0.7" MinWidth="160" />
                                        <Button x:Uid="RemoveButton" Tag="{x:Bind Subject}" Click="OnRemoveClick">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Uid="BackupsTab">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BackupNowButton" x:Uid="BackupNowButton" IsEnabled="{x:Bind ViewModel.Backups.CanAct, Mode=OneWay}" Command="{x:Bind ViewModel.Backups.CreateCommand, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar x:Name="BackupProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Backups.Progress, Mode=OneWay}" />
                    <ListView x:Name="BackupsListView" x:Uid="BackupsListView" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Backups.Items, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupItem">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Date}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                            <TextBlock Text="{x:Bind SizeText}" />
                                            <TextBlock Text="{x:Bind app:Strings.Origin(Origin)}" />
                                            <TextBlock Text="{x:Bind app:Strings.EncryptedLabel(Encrypted)}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Uid="RestoreButton" Grid.Column="1" Tag="{x:Bind Id}" Click="OnRestoreClick" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
