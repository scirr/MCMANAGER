<UserControl
    x:Class="MCManager.App.Views.CreateServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:MCManager.App">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateBackButton" x:Uid="BackButton" Click="OnBackClick">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <TextBlock x:Uid="CreateTitle" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="8,0" />
            </StackPanel>
            <TextBlock Text="{x:Bind app:Strings.WizardStep(ViewModel.Step), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFirstStep, Mode=OneWay}">
                <TextBox x:Name="CreateNameBox" x:Uid="CreateNameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
                <ComboBox x:Name="CreateLoaderBox" x:Uid="CreateLoaderBox" SelectedItem="{x:Bind ViewModel.Loader, Mode=TwoWay}" MinWidth="200" />
                <TextBox x:Name="CreateVersionBox" x:Uid="CreateVersionBox" Text="{x:Bind ViewModel.Version, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsMiddleStep, Mode=OneWay}">
                <TextBox x:Name="CreateRamBox" x:Uid="CreateRamBox" Text="{x:Bind ViewModel.Ram, Mode=TwoWay}" />
                <TextBox x:Name="CreatePortBox" x:Uid="CreatePortBox" Text="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                <TextBox x:Name="CreateRconPortBox" x:Uid="CreateRconPortBox" Text="{x:Bind ViewModel.RconPort, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsLastStep, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Loader, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Ram, Mode=OneWay}" />
                <TextBlock x:Uid="EulaText" TextWrapping="Wrap" />
                <CheckBox x:Name="EulaBox" x:Uid="EulaBox" IsChecked="{x:Bind ViewModel.AcceptEula, Mode=TwoWay}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="WizardBackButton" x:Uid="WizardBackButton" IsEnabled="{x:Bind ViewModel.CanBack, Mode=OneWay}" Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}" />
                <Button x:Name="WizardNextButton" x:Uid="WizardNextButton" Visibility="{x:Bind ViewModel.CanNext, Mode=OneWay}" Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}" />
                <Button x:Name="WizardCreateButton" x:Uid="WizardCreateButton" Visibility="{x:Bind ViewModel.IsLastStep, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" Command="{x:Bind ViewModel.CreateCommand, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
