{
  "components": {
    "schemas": {
      "ConfigDocument": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "$ref": "#/components/schemas/ServerConfig"
          }
        ]
      },
      "ConfigKey": {
        "description": "Keys settable through the API (SETTABLE_KEYS of mc_config).",
        "enum": [
          "port",
          "rcon_port",
          "mcrcon_pass",
          "ram_allocation",
          "cpu_affinity",
          "jar_name",
          "nom_serveur",
          "domaine",
          "webhook_url",
          "dossier_backup",
          "backup_retention_days",
          "backup_keep",
          "backup_encrypt_key_file",
          "stop_timeout",
          "curseforge_api_key",
          "internal_port",
          "metrics_allow_remote",
          "metrics_bind",
          "sleep_freeze",
          "sleep_hold_timeout",
          "sleep_join_mode",
          "sleep_proxy_protocol"
        ],
        "type": "string"
      },
      "ConfigSet": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ServerResult"
          },
          {
            "properties": {
              "key": {
                "$ref": "#/components/schemas/ConfigKey"
              },
              "restart_required": {
                "type": "boolean"
              },
              "updated": {
                "description": "Files and firewall rules updated.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "key",
              "restart_required"
            ],
            "type": "object"
          }
        ]
      },
      "ConfigSetRequest": {
        "properties": {
          "value": {
            "description": "New value. For mcrcon_pass, webhook_url and curseforge_api_key it is write-only.",
            "type": [
              "string",
              "integer"
            ],
            "writeOnly": true
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "ConfigValue": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ServerResult"
          },
          {
            "properties": {
              "key": {
                "$ref": "#/components/schemas/ConfigKey"
              },
              "value": {
                "description": "Absent for write-only keys; null when unset.",
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "write_only": {
                "description": "True for write-only keys: the value is never returned.",
                "type": "boolean"
              }
            },
            "required": [
              "key"
            ],
            "type": "object"
          }
        ]
      },
      "DoctorCheck": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "enum": [
              "ok",
              "info",
              "warn",
              "err"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "description": "False for `warn` and `err`.",
            "type": "boolean"
          },
          "server": {
            "description": "Null for a host check.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "server",
          "name",
          "ok",
          "level",
          "detail",
          "fix"
        ],
        "type": "object"
      },
      "DoctorReport": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "checks": {
                "description": "Host checks first (server null), then each server.",
                "items": {
                  "$ref": "#/components/schemas/DoctorCheck"
                },
                "type": "array"
              },
              "errors": {
                "description": "Number of `err` checks. The result is `ok:false` when it is above zero.",
                "type": "integer"
              },
              "has_issues": {
                "type": "boolean"
              },
              "warnings": {
                "type": "integer"
              }
            },
            "required": [
              "checks",
              "errors",
              "warnings",
              "has_issues"
            ],
            "type": "object"
          }
        ]
      },
      "JavaInstalled": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "major": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "path": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "major"
            ],
            "type": "object"
          }
        ]
      },
      "JavaRemoved": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "major": {
                "type": "integer"
              }
            },
            "required": [
              "major"
            ],
            "type": "object"
          }
        ]
      },
      "JavaRuntimes": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "runtimes": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Major version (as text) to path of the java executable.",
                "type": "object"
              },
              "servers": {
                "items": {
                  "properties": {
                    "java": {
                      "description": "`system` or a major version.",
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "minecraft": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "server": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "server",
                    "java"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "runtimes",
              "servers"
            ],
            "type": "object"
          }
        ]
      },
      "JavaUseRequest": {
        "properties": {
          "choice": {
            "description": "A major version already installed, or `system`.",
            "type": "string"
          }
        },
        "required": [
          "choice"
        ],
        "type": "object"
      },
      "JavaUsed": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ServerResult"
          },
          {
            "properties": {
              "major": {
                "type": "integer"
              },
              "restart_required": {
                "type": "boolean"
              }
            },
            "type": "object"
          }
        ]
      },
      "Metrics": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "daemon": {
                "properties": {
                  "devices": {
                    "type": "integer"
                  },
                  "jobs_running": {
                    "type": "integer"
                  },
                  "load_1m": {
                    "type": "number"
                  },
                  "uptime_s": {
                    "type": "integer"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "version",
                  "uptime_s"
                ],
                "type": "object"
              },
              "servers": {
                "items": {
                  "properties": {
                    "backups_count": {
                      "type": "integer"
                    },
                    "last_backup": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "players_max": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "players_online": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "rss_kb": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "state": {
                      "$ref": "#/components/schemas/ServerState"
                    },
                    "swap_kb": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "tps": {
                      "description": "Server ticks per second when measurable.",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "uptime_s": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "state"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "daemon",
              "servers"
            ],
            "type": "object"
          }
        ]
      },
      "ServerConfig": {
        "description": "Server configuration with every secret masked: secret keys are listed in `secrets_set` and never carry their value in a response (the CLI prints `***`).",
        "properties": {
          "activer_automodpack": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "always_on": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "backup_keep": {
            "type": "integer"
          },
          "backup_retention_days": {
            "type": "integer"
          },
          "cle_automodpack": {
            "type": "string"
          },
          "cpu_affinity": {
            "type": "string"
          },
          "description_serveur": {
            "type": "string"
          },
          "domaine": {
            "type": "string"
          },
          "dossier_backup": {
            "type": "string"
          },
          "heure_fermeture": {
            "type": "integer"
          },
          "heure_ouverture": {
            "type": "integer"
          },
          "jar_name": {
            "type": "string"
          },
          "java": {
            "type": "string"
          },
          "java_flags": {
            "type": "string"
          },
          "java_major": {
            "type": "integer"
          },
          "java_path": {
            "type": "string"
          },
          "loader": {
            "type": "string"
          },
          "loader_version": {
            "type": "string"
          },
          "mc_version": {
            "type": "string"
          },
          "minute_fermeture": {
            "type": "integer"
          },
          "minute_ouverture": {
            "type": "integer"
          },
          "mode_maintenance": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "modpack": {
            "additionalProperties": true,
            "description": "Installed modpack record (title, version, source...).",
            "type": "object"
          },
          "nom_serveur": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ram_allocation": {
            "type": "string"
          },
          "rcon_port": {
            "type": "integer"
          },
          "secrets_set": {
            "description": "Configured secrets; their values are never returned.",
            "items": {
              "enum": [
                "mcrcon_pass",
                "webhook_url",
                "curseforge_api_key",
                "backup_encrypt_key_file",
                "alerts",
                "backup_remotes"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "sleep_after": {
            "type": "integer"
          },
          "sleep_allow": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sleep_enabled": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "stop_reason": {
            "type": "string"
          },
          "stop_timeout": {
            "type": "integer"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "UpdateCheck": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "current": {
                "type": "string"
              },
              "latest": {
                "type": "string"
              },
              "rollback_available": {
                "type": "boolean"
              },
              "signed": {
                "type": "boolean"
              },
              "update_available": {
                "type": "boolean"
              }
            },
            "required": [
              "current",
              "latest",
              "update_available"
            ],
            "type": "object"
          }
        ]
      },
      "UpdateRequest": {
        "properties": {
          "version": {
            "description": "Target release tag; latest when null.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Updated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "properties": {
              "previous": {
                "type": "string"
              },
              "restarted": {
                "type": "boolean"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ],
            "type": "object"
          }
        ]
      }
    }
  },
  "paths": {
    "/v1/doctor": {
      "get": {
        "description": "`ok` is false when a check is in error (the answer is still 200).",
        "operationId": "getDoctorReport",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "checks": [
                    {
                      "detail": "openjdk 21.0.4",
                      "fix": null,
                      "level": "ok",
                      "name": "Java",
                      "ok": true,
                      "server": null
                    },
                    {
                      "detail": "25565 held by nginx (pid 912)",
                      "fix": "Free the port.",
                      "level": "warn",
                      "name": "Port",
                      "ok": false,
                      "server": "survie"
                    }
                  ],
                  "code": "doctor",
                  "errors": 0,
                  "has_issues": true,
                  "ok": true,
                  "schema": 1,
                  "warnings": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/DoctorReport"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Diagnostics of the host and every server",
        "tags": [
          "system"
        ],
        "x-mcm-role": "viewer",
        "x-mcm-source": [
          "mc_doctor.check_host",
          "mc_doctor.check_server",
          "mc_doctor.run_doctor"
        ]
      }
    },
    "/v1/java": {
      "get": {
        "operationId": "listJava",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": "java_list",
                  "ok": true,
                  "runtimes": {
                    "21": "/home/mc/.mcmanager/java/21/bin/java"
                  },
                  "schema": 1,
                  "servers": [
                    {
                      "java": 21,
                      "minecraft": "1.21.1",
                      "server": "survie"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/JavaRuntimes"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Installed Java runtimes and per-server choice",
        "tags": [
          "system"
        ],
        "x-mcm-role": "viewer",
        "x-mcm-source": [
          "mc_java.installed"
        ]
      }
    },
    "/v1/java/{major}": {
      "delete": {
        "operationId": "removeJava",
        "parameters": [
          {
            "description": "Java major version (8, 17, 21...).",
            "example": 21,
            "in": "path",
            "name": "major",
            "required": true,
            "schema": {
              "minimum": 8,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": "java_removed",
                  "major": 17,
                  "ok": true,
                  "schema": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/JavaRemoved"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Remove an installed runtime",
        "tags": [
          "system"
        ],
        "x-mcm-role": "admin",
        "x-mcm-source": [
          "mc_java.remove"
        ]
      },
      "put": {
        "description": "Job result: JavaInstalled. `java_present` is a success. `java_unavailable` (422) for an unsupported architecture, `java_download_failed` (503).",
        "operationId": "installJava",
        "parameters": [
          {
            "description": "Java major version (8, 17, 21...).",
            "example": 21,
            "in": "path",
            "name": "major",
            "required": true,
            "schema": {
              "minimum": 8,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "example": {
                  "code": null,
                  "created_at": "2026-10-08T10:00:00Z",
                  "id": "j_installjava",
                  "kind": "installJava",
                  "progress": 0,
                  "result": null,
                  "server": null,
                  "state": "running",
                  "updated_at": "2026-10-08T10:00:00Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Operation accepted; follow it on the job.",
            "headers": {
              "Location": {
                "description": "URL of the job.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "summary": "Install a Temurin runtime",
        "tags": [
          "system"
        ],
        "x-mcm-role": "admin",
        "x-mcm-source": [
          "mc_java.install"
        ]
      }
    },
    "/v1/metrics": {
      "get": {
        "description": "JSON by default; `Accept: text/plain` returns the Prometheus text exposition format.",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": "metrics",
                  "daemon": {
                    "load_1m": 0.4,
                    "uptime_s": 86400,
                    "version": "3.0.0"
                  },
                  "ok": true,
                  "schema": 1,
                  "servers": [
                    {
                      "name": "survie",
                      "players_max": 20,
                      "players_online": 2,
                      "rss_kb": 6291456,
                      "state": "running",
                      "swap_kb": 0,
                      "uptime_s": 7312
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              },
              "text/plain": {
                "example": "mcm_server_up{server=\"survie\"} 1\nmcm_players_online{server=\"survie\"} 2\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Metrics of the daemon and of every server",
        "tags": [
          "system"
        ],
        "x-mcm-role": "viewer",
        "x-mcm-source": [
          "mc_api.server_snapshot",
          "mc_api.query_players"
        ]
      }
    },
    "/v1/servers/{server}/config": {
      "get": {
        "operationId": "getServerConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "always_on": 1,
                  "code": "config",
                  "nom_serveur": "Survie",
                  "ok": true,
                  "port": 25565,
                  "ram_allocation": "6G",
                  "rcon_port": 25575,
                  "schema": 1,
                  "secrets_set": [
                    "mcrcon_pass",
                    "webhook_url"
                  ],
                  "sleep_after": 7200,
                  "sleep_enabled": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/ConfigDocument"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Server configuration (secrets excluded)",
        "tags": [
          "system"
        ],
        "x-mcm-role": "viewer",
        "x-mcm-source": [
          "mc_config.load_config"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/Server"
        }
      ]
    },
    "/v1/servers/{server}/config/{key}": {
      "get": {
        "description": "Write-only keys answer `write_only:true` and no value (`config_key_unset` 404 when not configured).",
        "operationId": "getConfigValue",
        "parameters": [
          {
            "description": "A settable key.",
            "example": "ram_allocation",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConfigKey"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "code": "config_value",
                  "key": "ram_allocation",
                  "ok": true,
                  "schema": 1,
                  "server": "survie",
                  "value": "6G",
                  "write_only": false
                },
                "schema": {
                  "$ref": "#/components/schemas/ConfigValue"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
